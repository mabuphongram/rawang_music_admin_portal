# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Backend API base URL, including /api (for example https://api.example.com/api).
APP_URL="MY_BACKEND_API_URL"

# Public MinIO bucket URL. Singer avatar object keys are appended to this URL.
MINIO_PREFIX_URL="https://minio.example.com/rawang-music"
